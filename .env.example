# Server-only secret from https://app.duffel.com/
DUFFEL_ACCESS_TOKEN=duffel_test_your_token

# Frontend URL of the deployed Flywise API, for example https://flywise-api.onrender.com
VITE_FLYWISE_API_URL=http://127.0.0.1:3000

# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://127.0.0.1:5173,https://wuisabel-gif.github.io
